IMAGE_PREFIX=ghcr.io/tanakrit-d/balatromultiplayerserverdocker
BMP_VERSION=1.0.2-r4
APPDATA_DIR=/mnt/user/appdata/balatro-mp-server
# Empty starts PostgreSQL and Nakama. Optional: api, web, moderation.
COMPOSE_PROFILES=
NAKAMA_BIND_ADDRESS=0.0.0.0
NAKAMA_PORT=7350
WEB_BASE_URL=http://YOUR_SERVER_IP:3000
# scripts/configure.py generates these for a new installation.
POSTGRES_PASSWORD=
NAKAMA_SESSION_KEY=
NAKAMA_REFRESH_KEY=
NAKAMA_HTTP_KEY=
NAKAMA_CONSOLE_PASSWORD=
NAKAMA_CONSOLE_SIGNING_KEY=
PLAYER_ID_SALT=
INTERNAL_API_KEY=
JWT_SECRET=
ADMIN_SECRET=
# Required only with COMPOSE_PROFILES=moderation and a model in model-cache.
MODERATION_REMOTE=
MODERATION_BEARER_TOKEN=
